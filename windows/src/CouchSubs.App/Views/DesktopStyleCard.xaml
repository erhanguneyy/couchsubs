<UserControl x:Class="CouchSubs.App.Views.DesktopStyleCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CouchSubs.App.Controls"
             xmlns:t="clr-namespace:CouchSubs.App.Theme"
             Visibility="Collapsed">
    <UserControl.Resources>
        <!-- Kaydırıcı satırı: ad, kaydırıcı, değer. -->
        <Style x:Key="RowLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="RowValue" TargetType="TextBlock" BasedOn="{StaticResource HintText}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Grid.Column" Value="2" />
        </Style>
        <Style x:Key="RowSlider" TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,12,0,8" />
        </Style>
    </UserControl.Resources>
    <c:Card Title="{t:T 'On the computer screen'}">
        <StackPanel>
            <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,12" TextWrapping="Wrap"
                       Text="{t:T 'Only the subtitle window on this computer. The TV and the OBS overlay keep their own look.'}" />
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{t:T 'Style'}" Style="{StaticResource RowLabel}" />
                <ComboBox x:Name="PresetChoice" Grid.Column="1" SelectionChanged="OnPreset" />
                <Button x:Name="ResetButton" Grid.Column="2" Margin="12,0,0,0" Content="{t:T 'Reset to defaults'}" Click="OnReset" />
            </Grid>
            <!-- Kendi görünümleri: adla kaydet, sil, dosyaya aktar. -->
            <WrapPanel Margin="0,0,0,12">
                <Button x:Name="SaveStyleButton" Content="{t:T 'Save style…'}" Margin="0,0,8,4" Click="OnSaveStyle" />
                <Button x:Name="DeleteStyleButton" Content="{t:T 'Delete style'}" Margin="0,0,8,4" Click="OnDeleteStyle" />
                <Button Content="{t:T 'Export…'}" Margin="0,0,8,4" Click="OnExportStyle" />
                <Button Content="{t:T 'Import…'}" Margin="0,0,8,4" Click="OnImportStyle" />
            </WrapPanel>
            <Grid x:Name="SaveStylePanel" Margin="0,0,0,12" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{t:T 'Name'}" Style="{StaticResource RowLabel}" />
                <TextBox x:Name="StyleName" Grid.Column="1" MaxLength="40" KeyDown="OnStyleNameKey" />
                <Button Grid.Column="2" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Content="{t:T 'Save'}" Click="OnConfirmSave" />
                <Button Grid.Column="3" Margin="8,0,0,0" Content="{t:T 'Cancel'}" Click="OnCancelSave" />
            </Grid>
            <TextBlock x:Name="LibraryMessage" Style="{StaticResource HintText}" Margin="0,0,0,12" TextWrapping="Wrap" Visibility="Collapsed" />

            <!-- Canlı önizleme: pencerenin kutusunun aynısı, örnek bir oyun sahnesinin üstünde. Bulanıklık da pencerede
                 olduğu gibi sahnenin kutunun arkasına düşen parçasından üretilir. -->
            <Border CornerRadius="{DynamicResource radius.control}" ClipToBounds="True">
                <Grid x:Name="PreviewRoot" MinHeight="170" SizeChanged="OnPreviewSize">
                    <Grid x:Name="PreviewScene">
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF2E4A6B" Offset="0" />
                                <GradientStop Color="#FF6E7F5A" Offset="0.55" />
                                <GradientStop Color="#FF2B2A26" Offset="1" />
                            </LinearGradientBrush>
                        </Grid.Background>
                        <Ellipse Width="140" Height="140" Fill="#FFF2B33D" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="40,-30,0,0" Opacity="0.85" />
                        <Rectangle Width="70" Height="190" Fill="#FF1B2433" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,90,0" />
                        <Rectangle Width="46" Height="120" Fill="#FF8A3B2E" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,170,0" />
                        <Rectangle Height="34" Fill="#FF3D5C35" VerticalAlignment="Bottom" />
                        <TextBlock Text="ENGLISH SUBTITLE IN THE GAME" Foreground="#FFFFFFFF" FontWeight="Bold" FontSize="18"
                                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,40" />
                    </Grid>
                    <StackPanel x:Name="PreviewLines" VerticalAlignment="Bottom" Margin="16,12" />
                </Grid>
            </Border>
            <Button HorizontalAlignment="Left" Margin="0,8,0,0" Content="{t:T 'Play animation'}" Click="OnPlayAnimation" x:Name="PlayButton" />

            <TextBlock Text="{t:T 'Text'}" Style="{StaticResource Section}" Margin="0,16,0,8" />
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{t:T 'Font'}" Style="{StaticResource RowLabel}" />
                <ComboBox x:Name="FontChoice" Grid.Column="1" SelectionChanged="OnFont" VirtualizingPanel.IsVirtualizing="True"
                          MaxDropDownHeight="360">
                    <!-- Her yazı tipi kendi görünüşüyle listelenir; liste sanallaştırıldığından yalnız görünenler çizilir. -->
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}" FontFamily="{Binding Family}" TextWrapping="NoWrap" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                    <ComboBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ComboBox.ItemsPanel>
                </ComboBox>
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{t:T 'Text size'}" Style="{StaticResource RowLabel}" />
                <Slider x:Name="SizeSlider" Style="{StaticResource RowSlider}" Minimum="16" Maximum="90" TickFrequency="1" SmallChange="1" LargeChange="4"
                        ValueChanged="OnSlider" Tag="FontSize" />
                <TextBlock x:Name="SizeValue" Style="{StaticResource RowValue}" />
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{t:T 'Weight'}" Style="{StaticResource RowLabel}" />
                <Slider x:Name="WeightSlider" Style="{StaticResource RowSlider}" Minimum="100" Maximum="900" TickFrequency="100" SmallChange="100" LargeChange="100"
                        ValueChanged="OnSlider" Tag="FontWeight" />
                <TextBlock x:Name="WeightValue" Style="{StaticResource RowValue}" />
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{t:T 'Line spacing'}" Style="{StaticResource RowLabel}" />
                <Slider x:Name="SpacingSlider" Style="{StaticResource RowSlider}" Minimum="1" Maximum="2" TickFrequency="0.05" SmallChange="0.05" LargeChange="0.1"
                        ValueChanged="OnSlider" Tag="LineSpacing" />
                <TextBlock x:Name="SpacingValue" Style="{StaticResource RowValue}" />
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{t:T 'Alignment'}" Style="{StaticResource RowLabel}" />
                <Border Grid.Column="1" Style="{StaticResource SegmentGroup}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="AlignLeft" Content="{t:T 'Left'}" GroupName="align" Style="{StaticResource SegmentButton}" Checked="OnAlignment" Tag="Left" />
                        <RadioButton x:Name="AlignCenter" Content="{t:T 'Center'}" GroupName="align" Style="{StaticResource SegmentButton}" Checked="OnAlignment" Tag="Center" />
                        <RadioButton x:Name="AlignRight" Content="{t:T 'Right'}" GroupName="align" Style="{StaticResource SegmentButton}" Checked="OnAlignment" Tag="Right" />
                    </StackPanel>
                </Border>
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{t:T 'Text color'}" Style="{StaticResource RowLabel}" />
                <ContentControl x:Name="TextColorRow" Grid.Column="1" Focusable="False" />
            </Grid>

            <TextBlock Text="{t:T 'Outline'}" Style="{StaticResource Section}" />
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{t:T 'Color'}" Style="{StaticResource RowLabel}" />
                <ContentControl x:Name="OutlineColorRow" Grid.Column="1" Focusable="False" />
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{t:T 'Thickness'}" Style="{StaticResource RowLabel}" />
                <Slider x:Name="OutlineSlider" Style="{StaticResource RowSlider}" Minimum="0" Maximum="8" TickFrequency="0.5" SmallChange="0.5" LargeChange="1"
                        ValueChanged="OnSlider" Tag="OutlineThickness" />
                <TextBlock x:Name="OutlineValue" Style="{StaticResource RowValue}" />
            </Grid>

            <TextBlock Text="{t:T 'Shadow'}" Style="{StaticResource Section}" />
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{t:T 'Color'}" Style="{StaticResource RowLabel}" />
                <ContentControl x:Name="ShadowColorRow" Grid.Column="1" Focusable="False" />
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{t:T 'Blur'}" Style="{StaticResource RowLabel}" />
                <Slider x:Name="BlurSlider" Style="{StaticResource RowSlider}" Minimum="0" Maximum="30" TickFrequency="1" SmallChange="1" LargeChange="4"
                        ValueChanged="OnSlider" Tag="ShadowBlur" />
                <TextBlock x:Name="BlurValue" Style="{StaticResource RowValue}" />
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{t:T 'Opacity'}" Style="{StaticResource RowLabel}" />
                <Slider x:Name="ShadowOpacitySlider" Style="{StaticResource RowSlider}" Minimum="0" Maximum="100" TickFrequency="1" SmallChange="1" LargeChange="10"
                        ValueChanged="OnSlider" Tag="ShadowOpacity" />
                <TextBlock x:Name="ShadowOpacityValue" Style="{StaticResource RowValue}" />
            </Grid>

            <TextBlock Text="{t:T 'Background'}" Style="{StaticResource Section}" />
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{t:T 'Color'}" Style="{StaticResource RowLabel}" />
                <ContentControl x:Name="BackgroundColorRow" Grid.Column="1" Focusable="False" />
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{t:T 'Opacity'}" Style="{StaticResource RowLabel}" />
                <Slider x:Name="BackgroundSlider" Style="{StaticResource RowSlider}" Minimum="0" Maximum="100" TickFrequency="1" SmallChange="1" LargeChange="10"
                        ValueChanged="OnSlider" Tag="BackgroundOpacity" />
                <TextBlock x:Name="BackgroundValue" Style="{StaticResource RowValue}" />
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{t:T 'Corner radius'}" Style="{StaticResource RowLabel}" />
                <Slider x:Name="CornerSlider" Style="{StaticResource RowSlider}" Minimum="0" Maximum="40" TickFrequency="1" SmallChange="1" LargeChange="4"
                        ValueChanged="OnSlider" Tag="CornerRadius" />
                <TextBlock x:Name="CornerValue" Style="{StaticResource RowValue}" />
            </Grid>

            <TextBlock Text="{t:T 'Background blur'}" Style="{StaticResource Section}" />
            <CheckBox x:Name="BlurChoice" Content="{t:T 'Blur the game behind the subtitle'}" Foreground="{DynamicResource textPrimaryBrush}"
                      Margin="0,0,0,8" Checked="OnToggle" Unchecked="OnToggle" Tag="BackgroundBlur" />
            <StackPanel x:Name="BlurOptions">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{t:T 'Strength'}" Style="{StaticResource RowLabel}" />
                <Slider x:Name="BlurRadiusSlider" Style="{StaticResource RowSlider}" Minimum="0" Maximum="40" TickFrequency="1" SmallChange="1" LargeChange="1"
                        ValueChanged="OnSlider" Tag="BlurRadius" />
                <TextBlock x:Name="BlurRadiusValue" Style="{StaticResource RowValue}" />
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{t:T 'Brightness'}" Style="{StaticResource RowLabel}" />
                <Slider x:Name="BrightnessSlider" Style="{StaticResource RowSlider}" Minimum="-50" Maximum="50" TickFrequency="1" SmallChange="1" LargeChange="1"
                        ValueChanged="OnSlider" Tag="BlurBrightness" />
                <TextBlock x:Name="BrightnessValue" Style="{StaticResource RowValue}" />
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{t:T 'Texture'}" Style="{StaticResource RowLabel}" />
                <Slider x:Name="NoiseSlider" Style="{StaticResource RowSlider}" Minimum="0" Maximum="20" TickFrequency="1" SmallChange="1" LargeChange="1"
                        ValueChanged="OnSlider" Tag="NoiseOpacity" />
                <TextBlock x:Name="NoiseValue" Style="{StaticResource RowValue}" />
            </Grid>
                <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,8"
                           Text="{t:T 'While blur is on, the subtitle window is left out of screenshots and OBS display capture (it would otherwise blur itself). Window capture of the game is not affected.'}" />
            </StackPanel>

            <CheckBox x:Name="GradientChoice" Content="{t:T 'Gradient background'}" Foreground="{DynamicResource textPrimaryBrush}"
                      Margin="0,8,0,8" Checked="OnToggle" Unchecked="OnToggle" Tag="BackgroundGradient" />
            <StackPanel x:Name="GradientOptions">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{t:T 'Second color'}" Style="{StaticResource RowLabel}" />
                <ContentControl x:Name="GradientColorRow" Grid.Column="1" Focusable="False" />
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{t:T 'Direction'}" Style="{StaticResource RowLabel}" />
                <Slider x:Name="AngleSlider" Style="{StaticResource RowSlider}" Minimum="0" Maximum="360" TickFrequency="15" SmallChange="15" LargeChange="15"
                        ValueChanged="OnSlider" Tag="GradientAngle" />
                <TextBlock x:Name="AngleValue" Style="{StaticResource RowValue}" />
            </Grid>
            </StackPanel>

            <TextBlock Text="{t:T 'Border'}" Style="{StaticResource Section}" />
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{t:T 'Thickness'}" Style="{StaticResource RowLabel}" />
                <Slider x:Name="BorderSlider" Style="{StaticResource RowSlider}" Minimum="0" Maximum="6" TickFrequency="0.5" SmallChange="0.5" LargeChange="0.5"
                        ValueChanged="OnSlider" Tag="BorderThickness" />
                <TextBlock x:Name="BorderValue" Style="{StaticResource RowValue}" />
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{t:T 'Color'}" Style="{StaticResource RowLabel}" />
                <ContentControl x:Name="BorderColorRow" Grid.Column="1" Focusable="False" />
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{t:T 'Opacity'}" Style="{StaticResource RowLabel}" />
                <Slider x:Name="BorderOpacitySlider" Style="{StaticResource RowSlider}" Minimum="0" Maximum="100" TickFrequency="1" SmallChange="1" LargeChange="1"
                        ValueChanged="OnSlider" Tag="BorderOpacity" />
                <TextBlock x:Name="BorderOpacityValue" Style="{StaticResource RowValue}" />
            </Grid>

            <TextBlock Text="{t:T 'Animation'}" Style="{StaticResource Section}" />
            <Border Style="{StaticResource SegmentGroup}" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="AnimationNone" Content="{t:T 'None'}" GroupName="animation" Style="{StaticResource SegmentButton}" Checked="OnAnimation" Tag="None" />
                    <RadioButton x:Name="AnimationFade" Content="{t:T 'Fade'}" GroupName="animation" Style="{StaticResource SegmentButton}" Checked="OnAnimation" Tag="Fade" />
                    <RadioButton x:Name="AnimationSlide" Content="{t:T 'Slide up'}" GroupName="animation" Style="{StaticResource SegmentButton}" Checked="OnAnimation" Tag="Slide" />
                    <RadioButton x:Name="AnimationZoom" Content="{t:T 'Zoom'}" GroupName="animation" Style="{StaticResource SegmentButton}" Checked="OnAnimation" Tag="Zoom" />
                </StackPanel>
            </Border>
            <Grid Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{t:T 'Duration'}" Style="{StaticResource RowLabel}" />
                <Slider x:Name="DurationSlider" Style="{StaticResource RowSlider}" Minimum="0" Maximum="1000" TickFrequency="50" SmallChange="50" LargeChange="50"
                        ValueChanged="OnSlider" Tag="AnimationDuration" />
                <TextBlock x:Name="DurationValue" Style="{StaticResource RowValue}" />
            </Grid>
            <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,8,0,0"
                       Text="{t:T 'New lines appear with the animation; lines that leave fade out over the same time.'}" />
        </StackPanel>
    </c:Card>
</UserControl>
